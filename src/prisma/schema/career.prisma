enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  OTHER
}

/// How far up a company - and by extension its job ads - is lifted in the career listings.
///
/// The values are declared in priority order on purpose: Postgres sorts an enum by the order its
/// values were declared, so `orderBy: { sponsorTier: 'asc' }` yields main sponsor first, then the
/// ordinary sponsors, then everyone else. Reordering these values silently reorders every listing
/// that sorts on this column, so treat the order as part of the contract.
enum CompanySponsorTier {
  MAIN
  SPONSOR
  NONE
}

model JobAd {
  id                  Int          @id @default(autoincrement())
  article             Article      @relation(fields: [articleId, articleName], references: [id, name], onDelete: Cascade)
  articleId           Int
  articleName         String
  description         String?
  ScreenPage          ScreenPage[]
  company             Company      @relation(fields: [companyId], references: [id])
  companyId           Int
  type                JobType
  location            String?
  applicationDeadline DateTime?
  active              Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, articleName])
}

model Company {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  description String
  logo        CmsImage           @relation(fields: [logoId], references: [id])
  logoId      Int                @unique
  /// Where the company's logo links to in the sponsor strip. Optional: a company that is not a
  /// sponsor has nowhere to link from, and a sponsor may simply not have given us a URL.
  website     String?
  /// At most one company may hold MAIN. The uniqueness is enforced by the updateSponsorTier
  /// service operation, which demotes the sitting main sponsor in the same transaction.
  sponsorTier CompanySponsorTier @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  JobAd     JobAd[]

  @@index([sponsorTier])
}
