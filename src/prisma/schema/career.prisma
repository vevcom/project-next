enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  OTHER
}

/// How far up a company - and its job ads - sit in the career listings.
///
/// Declared in priority order on purpose: Postgres sorts an enum by declaration order, so
/// `orderBy: { sponsorTier: 'asc' }` yields MAIN first. Reordering these values reorders every
/// listing that sorts on this column.
enum CompanySponsorTier {
  MAIN
  SPONSOR
  NONE
}

model JobAd {
  id                  Int          @id @default(autoincrement())
  article             Article      @relation(fields: [articleId, articleName], references: [id, name], onDelete: Cascade)
  articleId           Int
  articleName         String
  description         String?
  ScreenPage          ScreenPage[]
  company             Company      @relation(fields: [companyId], references: [id])
  companyId           Int
  type                JobType
  location            String?
  applicationDeadline DateTime?
  active              Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, articleName])
}

model Company {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  description String
  logo        CmsImage           @relation(fields: [logoId], references: [id])
  logoId      Int                @unique
  /// Where the logo links to in the sponsor strip.
  website     String?
  /// At most one company may hold MAIN, enforced by the updateSponsorTier operation rather than by
  /// the database - the index would have to be a partial one, which Prisma cannot express.
  sponsorTier CompanySponsorTier @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  JobAd     JobAd[]

  @@index([sponsorTier])
}
