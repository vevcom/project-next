{
  "name": "projectnext",
  "author": "vevcom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "IGNORE_SERVER_ONLY=true tsx src/lib/images/worker.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix --quiet",
    "lint:style": "stylelint \"src/**/*.{css,scss}\"",
    "test": "IGNORE_SERVER_ONLY=true jest",
    "docker:dev": "./development-entrypoint.sh",
    "docker:test": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from projectnext --attach projectnext --no-log-prefix",
    "docker:test:build": "docker compose --env-file .env.default -f docker-compose.prod.yml build",
    "docker:prod-local": "docker network create dokploy-network >/dev/null 2>&1 || true; docker compose -f docker-compose.prod.yml --profile localdb up --build",
    "docker:prod-deploy": "docker compose -f docker-compose.prod.yml up --build -d",
    "dobbelOmega:pull": "npx prisma db pull --schema ./src/prisma/owSchema/schema.ow.prisma",
    "dobbelOmega:generate": "npx prisma generate --schema ./src/prisma/owSchema/schema.ow.prisma",
    "dobbelOmega:run": "npx prisma migrate reset --force && MIGRATE_FROM_OW=true npm run seed:data",
    "docker:dobbelOmega:run": "docker compose -f docker-compose.dev.yml exec projectnext /bin/sh -c 'npm run dobbelOmega:run'",
    "docker:seed": "docker compose -f docker-compose.dev.yml exec projectnext /bin/sh -c 'npm run seed'",
    "seed": "npx prisma db push --force-reset && npm run seed:data",
    "seed:data": "IGNORE_SERVER_ONLY=true npx prisma db seed",
    "dev-seed": "(if [ ! -d './node_modules/.prisma-dobbel-omega' ]; then npm run dobbelOmega:generate; fi) && npm run seed && npm run dev",
    "migrate:dev": "npx prisma migrate dev",
    "migrate:deploy": "npx prisma migrate deploy",
    "prisma-studio": "DB_URI=\"postgresql://user:password@localhost/devdb\" npx prisma studio"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.6",
    "@stripe/react-stripe-js": "^3.3.0",
    "@stripe/stripe-js": "^5.9.2",
    "bcrypt": "^6.0.0",
    "canvas-confetti": "^1.9.4",
    "cli-progress": "^3.12.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "framer-motion": "^12.43.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "luxon": "^3.7.2",
    "next": "^16.1.6",
    "next-auth": "^4.24.11",
    "next-qrcode": "^2.5.1",
    "nodemailer": "^8.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-fontawesome": "^1.7.1",
    "react-intersection-observer": "^10.0.3",
    "react-pdf": "^10.4.1",
    "react-simplemde-editor": "^5.2.0",
    "rehype-format": "^5.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sass": "^1.97.3",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "stripe": "^17.7.0",
    "unified": "^11.0.5",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.1",
    "zod-form-data": "^2.0.4"
  },
  "overrides": {
    "nodemailer": "^8.0.5"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@jest/globals": "^30.3.0",
    "@stylistic/stylelint-plugin": "^5.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cli-progress": "^3.11.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "jest": "^30.3.0",
    "postcss-scss": "^4.0.9",
    "prisma": "^7.3.0",
    "stylelint": "^17.5.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
